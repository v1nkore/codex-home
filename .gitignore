# This repository uses an allowlist. New files copied from ~/.codex stay ignored
# until they are explicitly reviewed and allowed here.
*
!.gitignore
!README.md
!AGENTS.md
!config.portable.toml
!install.sh
!skills/
!skills/**
!docs/
!docs/**
!scripts/
!scripts/**
!sources/
!sources/**

# Keep local and credential files out of public skill snapshots.
**/.DS_Store
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/auth.json
**/*.pem
**/*.key
